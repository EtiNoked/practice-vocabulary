rules_version = '2';

/**
 * These rules are the ENTIRE server-side defence for this app.
 *
 * There is no backend, so nothing else validates a write. Anything permitted
 * here is reachable by anyone who opens DevTools. Every change must land with a
 * test in tests/rules/, covering the deny case as well as the allow case —
 * a rules suite that only proves the happy path proves nothing.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isNonEmptyString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow delete: if isOwner(uid);

      // A field whitelist, not a blocklist: an unknown field is rejected rather
      // than quietly stored. Keeps a client bug from bloating the document.
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['displayName', 'email', 'photoURL', 'createdAt', 'lastSeenAt']);

      match /lists/{listId} {
        allow read, delete: if isOwner(uid);

        // The caps are about blast radius, not malice: with no server to stop it,
        // one client bug could otherwise write an unbounded document.
        allow create, update: if isOwner(uid)
          && isNonEmptyString(request.resource.data.name, 200)
          && request.resource.data.pairs is list
          && request.resource.data.pairs.size() <= 500;
      }

      function pairsWithinCap(data, field) {
        // Capped IF PRESENT, never required. `rightPairs` is genuinely optional —
        // absent on every record written before 006, and on any drill above the
        // client's MAX_RIGHT_PAIRS cap — and requiring `wrongPairs` would reject
        // writes that have always been legitimate without making anything safer.
        return !(field in data.keys())
          || (data[field] is list && data[field].size() <= 500);
      }

      match /sessions/{sessionId} {
        allow read, delete: if isOwner(uid);
        // The 500 cap matches the lists collection above: a record cannot
        // legitimately be larger than the list it was drilled from. As there,
        // this is about blast radius rather than malice — one client bug could
        // otherwise write an unbounded document.
        allow create: if isOwner(uid)
          && request.resource.data.listId is string
          && request.resource.data.finishedAt is number
          && pairsWithinCap(request.resource.data, 'wrongPairs')
          && pairsWithinCap(request.resource.data, 'rightPairs');

        // History is a log, not a document. Enforcing append-only HERE rather
        // than in the UI means a client bug cannot rewrite the past.
        allow update: if false;
      }

      /*
       * Games (008). Their own collection, never `sessions`: a game spans several
       * lists where a session covers one, and an auto-marked score must not enter the
       * same average as a self-marked one.
       *
       * The caps are about blast radius, as everywhere else here — with no server to
       * stop it, one client bug could write an unbounded document. `results` is capped
       * at MAX_GAME_WORDS (50) with headroom, and is optional because a record whose
       * detail was shed under local storage pressure is still worth syncing for its
       * score.
       */
      match /games/{gameId} {
        allow read, delete: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.finishedAt is number
          && request.resource.data.listIds is list
          && request.resource.data.listIds.size() <= 20
          && request.resource.data.asked is number
          && (!('results' in request.resource.data.keys())
              || (request.resource.data.results is list
                  && request.resource.data.results.size() <= 100));

        // A log, not a document — the same rule sessions keep, for the same reason.
        allow update: if false;
      }

      /*
       * Saved tests (011). The one collection here that is a DOCUMENT rather than a log.
       *
       * `allow update` is TRUE, deliberately, where sessions and games forbid it. A saved
       * test is a definition the user edits — rename it, add a list, change the cap — and
       * refusing updates would mean every edit created a second test. History is the
       * opposite: nothing may rewrite what happened.
       *
       * The caps are about blast radius, as everywhere else here: with no server to stop
       * it, one client bug could write an unbounded document. `listIds` is validated as a
       * list and by length rather than element by element, so a later change to the spec's
       * shape does not need a rules change to go with it.
       */
      match /tests/{testId} {
        allow read, delete: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && isNonEmptyString(request.resource.data.name, 200)
          && request.resource.data.spec.listIds is list
          && request.resource.data.spec.listIds.size() <= 20;
      }
    }

    // No catch-all match at the root. Anything not named above is denied, which
    // is the default we want. Do not add one.
  }
}
